# Copy to .env and replace placeholders using the Aiven dashboard.
# Keep the URI on one line. URL-encode special characters in the username/password.
DATABASE_URL=mysql://<AIVEN_USER>:<URL_ENCODED_PASSWORD>@<AIVEN_HOST>:<AIVEN_PORT>/<AIVEN_DATABASE>?ssl-mode=REQUIRED

# Download the CA certificate from the Aiven service page and save it inside Web UI/.
# TLS certificate and hostname verification are always enforced by the application.
AIVEN_CA_CERT=ca.pem

# Generate a unique random value of at least 32 characters for this app.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# false for local HTTP development; true when served behind HTTPS.
COOKIE_SECURE=false
