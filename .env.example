# Copy to .env and replace each placeholder. Never commit your real .env.
# Get the PostgreSQL URI from Supabase Dashboard > Project Settings > Database.
# Use a server-side connection URI (direct or Supavisor pooler) with SSL enabled.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DB_HOST:5432/postgres?sslmode=require

# Generate a unique long random secret for local sessions; replace for every deployment.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Set true only when serving the app over HTTPS; leave false for localhost development.
COOKIE_SECURE=false
